<Mission #adopt-halfcode-kind-system apiVersion="codument.tech/v1alpha1" version="1" { status = "archived" goal = "以版本化 CLI 基座和 Halfcode KindDefinition 逐步统一 Codument 结构化产物。" description = "先工程化 Codument CLI，再补齐 Halfcode，最后正式接入并按真实反馈演进 compiler。" question_mode = "decision-tree" question_severity = "auto" revision = 21 created_at = "2026-08-15T09:30:00Z" updated_at = "2026-08-16T08:19:46.774Z" } (
  <Ports { scope = "mission" } [
    <MaterialBundle { role = "state" name = "reports" domain = "mission" path = "vfs://./reports/" }>
    <MaterialBundle { role = "output" name = "tracks" domain = "codument" path = "vfs://@/codument/tracks/" }>
  ]>
  <ProjectRefs [
    <ProjectRef #codument { kind = "host" }>
    <ProjectRef #halfcode-compiler-xnl { kind = "external" }>
  ]>
  <ActorSets { default = "codument-loop" } [
    <ActorSet #codument-loop [
      <Actor { role = "MissionPlanner" project_ref = "codument" } (
        <Description ?01M02K495QG3MAZB8XB1S1SG57>
        按 Codument CLI、Kind 和迁移依赖切分并修订 host tracks。
        </?01M02K495QG3MAZB8XB1S1SG57>
      )>
      <Actor { role = "MissionObserver" project_ref = "codument" } (
        <Description ?01M02K495QG3MAZB8XB1S1SG58>
        读取 CLI E2E、workspace 资产、Halfcode package contract 与 track 实际态。
        </?01M02K495QG3MAZB8XB1S1SG58>
      )>
      <Actor { role = "MissionReconciler" project_ref = "codument" } (
        <Description ?01M02K495QG3MAZB8XB1S1SG59>
        比较版本化 authoring 目标与实际能力，选择下一条可验证 track。
        </?01M02K495QG3MAZB8XB1S1SG59>
      )>
      <Actor { role = "MissionApplier" project_ref = "codument" } (
        <Description ?01M02K495QG3MAZB8XB1S1SG5A>
        连续规划、实现和验证 Codument track，并在明确通过后推进下一节点。
        </?01M02K495QG3MAZB8XB1S1SG5A>
      )>
    ]>
    <ActorSet #halfcode-loop [
      <Actor { role = "MissionPlanner" project_ref = "halfcode-compiler-xnl" } (
        <Description ?01M02K495QG3MAZB8XB1S1SG5B>
        把 Codument 集成证据收敛为 Halfcode compiler 能力 tracks。
        </?01M02K495QG3MAZB8XB1S1SG5B>
      )>
      <Actor { role = "MissionObserver" project_ref = "halfcode-compiler-xnl" } (
        <Description ?01M02K495QG3MAZB8XB1S1SG5C>
        观察 Halfcode KindDefinition、resource loader、package consumer 和发布状态。
        </?01M02K495QG3MAZB8XB1S1SG5C>
      )>
      <Actor { role = "MissionReconciler" project_ref = "halfcode-compiler-xnl" } (
        <Description ?01M02K495QG3MAZB8XB1S1SG5D>
        判断版本化 Kind 与多根文档能力是否满足 Codument 的真实调用。
        </?01M02K495QG3MAZB8XB1S1SG5D>
      )>
      <Actor { role = "MissionApplier" project_ref = "halfcode-compiler-xnl" } (
        <Description ?01M02K495QG3MAZB8XB1S1SG5E>
        执行 Halfcode 侧 track、发布验证版本并把证据返回 Codument。
        </?01M02K495QG3MAZB8XB1S1SG5E>
      )>
    ]>
  ]>
  <TaskSpace #space_adopt-halfcode-kind-system { name = "adopt-halfcode-kind-system" child_mode = "dag" } (
    <Description ?01M02K495QG3MAZB8XB1S1SG5F>
    Codument CLI foundation, Halfcode capability completion, and formal integration.
    </?01M02K495QG3MAZB8XB1S1SG5F>
    <SubNodes [
      <TaskGroup #G1 { name = "Codument CLI 基座" status = "DONE" order = 0 } (
        <Description ?01M02K495QG3MAZB8XB1S1SG5G>
        建立版本化创建与迁移所需的确定性 CLI authority。
        </?01M02K495QG3MAZB8XB1S1SG5G>
        <SubNodes [
          <Task #G1-T1 { name = "建立版本化 CLI 与 scaffold 基座" status = "DONE" order = 0 } (
            <TrackLink #build-versioned-cli-foundation { state = "bound" project_ref = "codument" }>
          )>
          <Task #G1-T2 { name = "建立结构化资源迁移基座" status = "DONE" order = 1 } (
            <TrackLink #add-structured-resource-migrations { state = "bound" project_ref = "codument" }>
          )>
        ]>
      )>
      <TaskGroup #G2 { name = "Halfcode 能力补齐" status = "DONE" order = 1 actor_set = "halfcode-loop" } (
        <Description ?01M02K495QG3MAZB8XB1S1SG5H>
