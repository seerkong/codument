        </?01M02K495QG3MAZB8XB1S1SG5H>
        <SubNodes [
          <Task #G2-T1 { name = "支持版本化 KindDefinition 与迁移注册" status = "DONE" order = 0 } (
            <TrackLink #add-versioned-kind-definitions { state = "bound" project_ref = "halfcode-compiler-xnl" }>
          )>
          <Task #G2-T2 { name = "支持多根 XNL 文档与 forest cardinality" status = "DONE" order = 1 } (
            <TrackLink #support-multi-root-xnl-documents { state = "bound" project_ref = "halfcode-compiler-xnl" }>
          )>
        ]>
      )>
      <TaskGroup #G3 { name = "Codument 正式接入" status = "DONE" order = 2 } (
        <Description ?01M02K495QG3MAZB8XB1S1SG5J>
        消费 Halfcode public package，定义 Codument Kinds，并按真实反馈继续补齐 compiler。
        </?01M02K495QG3MAZB8XB1S1SG5J>
        <SubNodes [
          <Task #G3-T1 { name = "接入 Halfcode Kind compiler" status = "DONE" order = 0 } (
            <TrackLink #integrate-halfcode-kind-compiler { state = "bound" project_ref = "codument" }>
          )>
          <Task #G3-T2 { name = "将 Track authority 从 XML 迁移到 XNL" status = "DONE" order = 1 } (
            <TrackLink #migrate-track-kind-to-xnl { state = "bound" project_ref = "codument" }>
          )>
          <Task #G3-T3 { name = "根据集成证据补齐 Halfcode 并复验" status = "DONE" order = 2 } (
            <TrackLink #expose-kind-definition-registry { state = "bound" project_ref = "halfcode-compiler-xnl" }>
          )>
          <Task #G3-T4 { name = "将 Mission authority 从 XML 迁移到 XNL" status = "DONE" order = 3 } (
            <TrackLink #migrate-mission-kind-to-xnl { state = "bound" project_ref = "codument" }>
          )>
          <Task #G3-T5 { name = "盘点并规划剩余 XML Kind" status = "DONE" order = 4 }>
          <Task #G3-T6 { name = "支持 single-file catalog 精确 entry" status = "DONE" order = 5 } (
            <TrackLink #support-single-file-catalog-entry { state = "bound" project_ref = "halfcode-compiler-xnl" }>
          )>
          <Task #G3-T7 { name = "将配置 Kind 从 XML 迁移到 XNL" status = "DONE" order = 6 } (
            <TrackLink #migrate-config-kinds-to-xnl { state = "bound" project_ref = "codument" }>
          )>
          <Task #G3-T8 { name = "将 Behavior registry authority 从 XML 迁移到 XNL" status = "DONE" order = 7 } (
            <TrackLink #migrate-behavior-kind-to-xnl { state = "bound" project_ref = "codument" }>
          )>
          <Task #G3-T9 { name = "将 BehaviorPatch authority 从 XML 迁移到 XNL" status = "DONE" order = 8 } (
            <TrackLink #migrate-behavior-patch-kind-to-xnl { state = "bound" project_ref = "codument" }>
          )>
          <Task #G3-T10 { name = "统一单资源升级并修复 Decision 业务目录迁移" status = "DONE" order = 9 } (
            <TrackLink #add-unified-resource-upgrade { state = "bound" project_ref = "codument" }>
          )>
          <Task #G3-T11 { name = "让 BehaviorPatch 使用 XNL 原生 mutation 执行器" status = "DONE" order = 10 } (
            <TrackLink #use-native-xnl-behavior-mutations { state = "bound" project_ref = "codument" }>
          )>
          <Task #G3-T12 { name = "将 operation 机械护栏迁入 CLI" status = "DONE" order = 11 } (
            <TrackLink #move-operation-guardrails-to-cli { state = "bound" project_ref = "codument" }>
          )>
        ]>
      )>
    ]>
  )>
  <Schedule [
    <Dag { for = "space_adopt-halfcode-kind-system" } [
      <Node #G2 [
        <After { ref = "G1" }>
