<Track #redesign-mission-workflow apiVersion="codument.tech/v1alpha1" version="1" { status = "completed" goal = "重新设计 Codument mission 工作流，使 mission 成为支持长周期自动化的控制论 + DEPA actor 编排对象。" description = "新增 mission.xml 规范、pending/active/archived 目录结构、mission 三个 lifecycle operation、mission actor 执行协议，并提升 flow notation 为标准 spec。" commit_mode = "manual" created_at = "2026-06-27T13:56:11Z" updated_at = "2026-06-27T14:33:33Z" } (
