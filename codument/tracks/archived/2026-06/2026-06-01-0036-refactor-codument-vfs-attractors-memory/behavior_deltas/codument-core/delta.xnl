<BehaviorPatch #track.r_2_0_2_6_-_0_6_-_0_1_-_0_0_3_6_-_r_e_f_a_c_t_o_r_-_c_o_d_u_m_e_n_t_-_v_f_s_-_a_t_t_r_a_c_t_o_r_s_-_m_e_m_o_r_y.behavior_patch.codument-core apiVersion="codument.tech/v1alpha1" version="1" { capability = "codument-core" } (
  <Mutations [
    <Upsert { selector = "behavior://codument-core/requirements/codument-must-support-xml-spec-registry" } (
      <Requirement #codument-must-support-xml-spec-registry (
        <Statement ?01M02NT0W2JK6CDRA83D69FWAB>
        系统应当（SHALL）支持以 XML 文件表达 `codument/specs/` 下的 capability contract registry，并保留从 Markdown spec 迁移的兼容路径。
        </?01M02NT0W2JK6CDRA83D69FWAB>
        <Suites [
          <Suite { name = "codument-must-support-xml-spec-registry" } (
            <Cases [
              <Case #xml-spec-contains-bdd-cases { name = "XML spec contains BDD cases" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWAC>
                一个 capability 需要表达可测试行为
                </?01M02NT0W2JK6CDRA83D69FWAC>
                <When ?01M02NT0W2JK6CDRA83D69FWAD>
                维护者创建 XML spec
                </?01M02NT0W2JK6CDRA83D69FWAD>
                <Then ?01M02NT0W2JK6CDRA83D69FWAE>
                spec 可以包含 `capability`、`requirement`、`statement`、`suite`、`case` 节点
                `case` 节点可以包含 `given`、`when`、`then`
                这些 case 可用于指导测试 case 组织
                </?01M02NT0W2JK6CDRA83D69FWAE>
              )>
              <Case #xml-spec-supports-nested-suites { name = "XML spec supports nested suites" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWAF>
                一个 requirement 下存在多层测试语境
                </?01M02NT0W2JK6CDRA83D69FWAF>
                <When ?01M02NT0W2JK6CDRA83D69FWAG>
                维护者组织 XML spec
                </?01M02NT0W2JK6CDRA83D69FWAG>
                <Then ?01M02NT0W2JK6CDRA83D69FWAH>
                可以在 `requirement` 下创建嵌套 `suite`
                叶子行为场景使用 `case`
                不需要用 Markdown 标题层级表达测试语境
                </?01M02NT0W2JK6CDRA83D69FWAH>
              )>
              <Case #large-xml-spec-upgrades-to-same-name-folder { name = "Large XML spec upgrades to same-name folder" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWAJ>
                一个 XML spec 文件内容过长
                </?01M02NT0W2JK6CDRA83D69FWAJ>
                <When ?01M02NT0W2JK6CDRA83D69FWAK>
                维护者或 AI 拆分该 spec
                </?01M02NT0W2JK6CDRA83D69FWAK>
                <Then ?01M02NT0W2JK6CDRA83D69FWAM>
                可以将 `codument/specs/&lt;capability&gt;.xml` 升级为 `codument/specs/&lt;capability&gt;/index.xml`
                通过 `include` 引用拆分出的 requirement 或 suite 文件
                逻辑 selector 不因物理拆分而改变
                </?01M02NT0W2JK6CDRA83D69FWAM>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/codument-must-provide-vfs-uri-selectors" } (
      <Requirement #codument-must-provide-vfs-uri-selectors (
        <Statement ?01M02NT0W2JK6CDRA83D69FWAN>
        系统应当（SHALL）提供统一 VFS URI namespace，用于 spec、decision、memory、attractor、track、archive、knowledge 和 test 的逻辑引用。
        </?01M02NT0W2JK6CDRA83D69FWAN>
        <Suites [
          <Suite { name = "codument-must-provide-vfs-uri-selectors" } (
            <Cases [
              <Case #spec-selector-uses-spec-uri { name = "Spec selector uses spec URI" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWAP>
                一个 spec patch 需要定位某个 case
                </?01M02NT0W2JK6CDRA83D69FWAP>
                <When ?01M02NT0W2JK6CDRA83D69FWAQ>
                patch 声明 selector
                </?01M02NT0W2JK6CDRA83D69FWAQ>
                <Then ?01M02NT0W2JK6CDRA83D69FWAR>
                selector 使用 `spec://...`
                selector 不使用真实文件路径
                </?01M02NT0W2JK6CDRA83D69FWAR>
              )>
              <Case #decision-selector-uses-decision-uri { name = "Decision selector uses decision URI" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWAS>
                一个长期决策需要被引用
                </?01M02NT0W2JK6CDRA83D69FWAS>
                <When ?01M02NT0W2JK6CDRA83D69FWAT>
                track、spec 或 memory 关联该决策
                </?01M02NT0W2JK6CDRA83D69FWAT>
                <Then ?01M02NT0W2JK6CDRA83D69FWAV>
                使用 `decision://...` 作为逻辑引用
                </?01M02NT0W2JK6CDRA83D69FWAV>
              )>
              <Case #knowledge-target-uses-knowledge-uri-only-when-enabled { name = "Knowledge target uses knowledge URI only when enabled" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWAW>
                `knowledgeSync.enabled=true`
                </?01M02NT0W2JK6CDRA83D69FWAW>
                <When ?01M02NT0W2JK6CDRA83D69FWAX>
                spec 或 plan 需要提示 docs 同步位置
                </?01M02NT0W2JK6CDRA83D69FWAX>
                <Then ?01M02NT0W2JK6CDRA83D69FWAY>
                可以使用 `knowledge://&lt;target-name&gt;/...`
                未启用 knowledge sync 时不应生成 knowledge hint
                </?01M02NT0W2JK6CDRA83D69FWAY>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/codument-must-support-generic-xml-mutation-protocol" } (
      <Requirement #codument-must-support-generic-xml-mutation-protocol (
        <Statement ?01M02NT0W2JK6CDRA83D69FWAZ>
        系统应当（SHALL）使用通用 XML node mutation protocol 表达 spec delta，而不是为每类领域节点创建独立操作类型。
        </?01M02NT0W2JK6CDRA83D69FWAZ>
        <Suites [
          <Suite { name = "codument-must-support-generic-xml-mutation-protocol" } (
            <Cases [
              <Case #upsert-xml-node { name = "Upsert XML node" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWB0>
                track 需要新增或替换 spec case
                </?01M02NT0W2JK6CDRA83D69FWB0>
                <When ?01M02NT0W2JK6CDRA83D69FWB1>
                spec patch 包含 `op=&quot;upsert&quot;` 和 `selector=&quot;spec://...&quot;`
                </?01M02NT0W2JK6CDRA83D69FWB1>
                <Then ?01M02NT0W2JK6CDRA83D69FWB2>
                系统将该 XML 节点写入 selector 对应逻辑位置
                </?01M02NT0W2JK6CDRA83D69FWB2>
              )>
              <Case #delete-xml-node { name = "Delete XML node" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWB3>
                track 需要移除 spec case
                </?01M02NT0W2JK6CDRA83D69FWB3>
                <When ?01M02NT0W2JK6CDRA83D69FWB4>
                spec patch 包含 `op=&quot;delete&quot;` 和 `selector=&quot;spec://...&quot;`
                </?01M02NT0W2JK6CDRA83D69FWB4>
                <Then ?01M02NT0W2JK6CDRA83D69FWB5>
                系统删除 selector 对应节点
                </?01M02NT0W2JK6CDRA83D69FWB5>
              )>
              <Case #move-xml-node { name = "Move XML node" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWB6>
                track 需要移动 requirement 或 suite
                </?01M02NT0W2JK6CDRA83D69FWB6>
                <When ?01M02NT0W2JK6CDRA83D69FWB7>
                spec patch 包含 `op=&quot;move&quot;`、`selector=&quot;spec://...&quot;` 和 `to=&quot;spec://...&quot;`
                </?01M02NT0W2JK6CDRA83D69FWB7>
                <Then ?01M02NT0W2JK6CDRA83D69FWB8>
                系统移动该逻辑节点
                </?01M02NT0W2JK6CDRA83D69FWB8>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/codument-must-create-project-attractors-directory-for-new-projects" } (
      <Requirement #codument-must-create-project-attractors-directory-for-new-projects (
        <Statement ?01M02NT0W2JK6CDRA83D69FWB9>
        系统应当（SHALL）在新项目初始化时创建 `codument/attractors/`，并将项目级 product/project 类上下文放入该目录。
        </?01M02NT0W2JK6CDRA83D69FWB9>
        <Suites [
          <Suite { name = "codument-must-create-project-attractors-directory-for-new-projects" } (
            <Cases [
              <Case #new-init-creates-attractors { name = "New init creates attractors" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWBA>
                用户在新项目运行 `codument init`
                </?01M02NT0W2JK6CDRA83D69FWBA>
                <When ?01M02NT0W2JK6CDRA83D69FWBB>
                初始化完成
                </?01M02NT0W2JK6CDRA83D69FWBB>
                <Then ?01M02NT0W2JK6CDRA83D69FWBC>
                系统创建 `codument/attractors/product.md`
                系统创建 `codument/attractors/project.md`
                系统不再生成 `codument/tech-stack.md`
                </?01M02NT0W2JK6CDRA83D69FWBC>
              )>
              <Case #std-agents-reads-attractors-directory { name = "std AGENTS reads attractors directory" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWBD>
                AI 助手开始处理 Codument 项目
                </?01M02NT0W2JK6CDRA83D69FWBD>
                <When ?01M02NT0W2JK6CDRA83D69FWBE>
                助手读取 `codument/std/AGENTS.md`
                </?01M02NT0W2JK6CDRA83D69FWBE>
                <Then ?01M02NT0W2JK6CDRA83D69FWBF>
                指南要求根据任务读取 `codument/attractors/` 下相关文件
                不假设 attractors 目录只有固定文件名
                </?01M02NT0W2JK6CDRA83D69FWBF>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/codument-must-upgrade-old-workspaces-to-the-new-format" } (
      <Requirement #codument-must-upgrade-old-workspaces-to-the-new-format (
        <Statement ?01M02NT0W2JK6CDRA83D69FWBG>
        系统应当（SHALL）通过 `codument upgrade-workspace` 将旧项目补齐到新的 Codument 目录、配置和兼容读取格式。
        </?01M02NT0W2JK6CDRA83D69FWBG>
        <Suites [
          <Suite { name = "codument-must-upgrade-old-workspaces-to-the-new-format" } (
            <Cases [
              <Case #upgrade-creates-missing-new-structure { name = "Upgrade creates missing new structure" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWBH>
                一个旧项目只有旧版 `codument/project.md`、`codument/product.md`、`codument/specs/` 和标准文件
                </?01M02NT0W2JK6CDRA83D69FWBH>
                <When ?01M02NT0W2JK6CDRA83D69FWBJ>
                用户运行 `codument upgrade-workspace`
                </?01M02NT0W2JK6CDRA83D69FWBJ>
                <Then ?01M02NT0W2JK6CDRA83D69FWBK>
                系统创建缺失的 `codument/attractors/`
                系统创建缺失的 `codument/config/feature.json`
                默认关闭 `knowledgeSync` 和 `projectMemory`
                系统不删除旧项目文件
                </?01M02NT0W2JK6CDRA83D69FWBK>
              )>
              <Case #upgrade-preserves-existing-user-edits { name = "Upgrade preserves existing user edits" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWBM>
                旧项目已经手动创建或编辑了 `codument/attractors/` 或 `codument/config/feature.json`
                </?01M02NT0W2JK6CDRA83D69FWBM>
                <When ?01M02NT0W2JK6CDRA83D69FWBN>
                用户运行 `codument upgrade-workspace`
                </?01M02NT0W2JK6CDRA83D69FWBN>
                <Then ?01M02NT0W2JK6CDRA83D69FWBP>
                系统不覆盖已有 attractor 内容
                系统不改变已有 feature 配置值
                仅补齐明确缺失且安全的默认项
                </?01M02NT0W2JK6CDRA83D69FWBP>
              )>
              <Case #old-specs-are-preserved-when-conversion-is-unsafe { name = "Old specs are preserved when conversion is unsafe" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWBQ>
                旧项目存在 Markdown spec
                </?01M02NT0W2JK6CDRA83D69FWBQ>
                <When ?01M02NT0W2JK6CDRA83D69FWBR>
                用户运行 `codument upgrade-workspace`
                </?01M02NT0W2JK6CDRA83D69FWBR>
                <Then ?01M02NT0W2JK6CDRA83D69FWBS>
                系统保留旧 spec 原路径以支持兼容读取
                系统无法保证自动转换为 XML 后语义等价
                系统将旧 spec 复制到 `codument/legacy/specs/...`
                如果实现存在临时备份机制，系统也可以写入临时备份
                临时备份不能替代 `codument/legacy/`
                </?01M02NT0W2JK6CDRA83D69FWBS>
              )>
              <Case #legacy-directory-stores-migration-evidence { name = "Legacy directory stores migration evidence" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWBT>
                旧项目包含不再作为新格式入口的文件
                </?01M02NT0W2JK6CDRA83D69FWBT>
                <When ?01M02NT0W2JK6CDRA83D69FWBV>
                upgrade 无法或不应自动迁移这些内容
                </?01M02NT0W2JK6CDRA83D69FWBV>
                <Then ?01M02NT0W2JK6CDRA83D69FWBW>
                系统在 `codument/legacy/` 中保存可读副本
                `codument/legacy/` 不作为新的事实真源
                `codument/legacy/` 不生成中心 `index.md`
                </?01M02NT0W2JK6CDRA83D69FWBW>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/codument-must-provide-feature-config" } (
      <Requirement #codument-must-provide-feature-config (
        <Statement ?01M02NT0W2JK6CDRA83D69FWBX>
        系统应当（SHALL）提供 `codument/config/feature.json` 控制可选能力，并在缺失时使用默认关闭语义。
        </?01M02NT0W2JK6CDRA83D69FWBX>
        <Suites [
          <Suite { name = "codument-must-provide-feature-config" } (
            <Cases [
              <Case #missing-feature-config-defaults-to-disabled { name = "Missing feature config defaults to disabled" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWBY>
                老项目没有 `codument/config/feature.json`
                </?01M02NT0W2JK6CDRA83D69FWBY>
                <When ?01M02NT0W2JK6CDRA83D69FWBZ>
                Codument 判断 knowledge sync 或 project memory 是否启用
                </?01M02NT0W2JK6CDRA83D69FWBZ>
                <Then ?01M02NT0W2JK6CDRA83D69FWC0>
                `knowledgeSync.enabled` 等价为 `false`
                `projectMemory.enabled` 等价为 `false`
                </?01M02NT0W2JK6CDRA83D69FWC0>
              )>
              <Case #upgrade-preserves-existing-feature-config { name = "Upgrade preserves existing feature config" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWC1>
                项目已有 `codument/config/feature.json`
                </?01M02NT0W2JK6CDRA83D69FWC1>
                <When ?01M02NT0W2JK6CDRA83D69FWC2>
                用户运行 `codument upgrade-workspace`
                </?01M02NT0W2JK6CDRA83D69FWC2>
                <Then ?01M02NT0W2JK6CDRA83D69FWC3>
                系统不覆盖已有配置项
                仅在安全缺省范围内补齐缺失配置
                </?01M02NT0W2JK6CDRA83D69FWC3>
              )>
              <Case #knowledge-sync-target-may-be-outside-workspace { name = "Knowledge sync target may be outside workspace" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWC4>
                `knowledgeSync.enabled=true`
                </?01M02NT0W2JK6CDRA83D69FWC4>
                <When ?01M02NT0W2JK6CDRA83D69FWC5>
                系统执行知识同步任务
                </?01M02NT0W2JK6CDRA83D69FWC5>
                <Then ?01M02NT0W2JK6CDRA83D69FWC6>
                仅使用配置中显式声明的绝对路径
                target root 是绝对路径
                不自行猜测 workspace 外目录
                </?01M02NT0W2JK6CDRA83D69FWC6>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/codument-must-archive-tracks-using-minute-level-updated-time" } (
      <Requirement #codument-must-archive-tracks-using-minute-level-updated-time (
        <Statement ?01M02NT0W2JK6CDRA83D69FWC7>
        系统应当（SHALL）使用 track 最后更新时间生成 archive 路径，而不是使用归档命令执行日期。
        </?01M02NT0W2JK6CDRA83D69FWC7>
        <Suites [
          <Suite { name = "codument-must-archive-tracks-using-minute-level-updated-time" } (
            <Cases [
              <Case #archive-path-uses-yyyy-mm-bucket { name = "Archive path uses YYYY-MM bucket" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWC8>
                track 最后更新时间是 `2026-05-30T14:32:00+08:00`
                </?01M02NT0W2JK6CDRA83D69FWC8>
                <When ?01M02NT0W2JK6CDRA83D69FWC9>
                用户归档 track `refactor-spec-xml-vfs`
                </?01M02NT0W2JK6CDRA83D69FWC9>
                <Then ?01M02NT0W2JK6CDRA83D69FWCA>
                归档路径为 `codument/archive/2026-05/2026-05-30-1432-refactor-spec-xml-vfs/`
                </?01M02NT0W2JK6CDRA83D69FWCA>
              )>
              <Case #late-archive-preserves-iteration-order { name = "Late archive preserves iteration order" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWCB>
                track 在 2026-05-30 最后更新
                </?01M02NT0W2JK6CDRA83D69FWCB>
                <When ?01M02NT0W2JK6CDRA83D69FWCC>
                系统生成 archive 目录
                </?01M02NT0W2JK6CDRA83D69FWCC>
                <Then ?01M02NT0W2JK6CDRA83D69FWCD>
                目录时间前缀仍使用 2026-05-30 的 track 最后更新时间
                用户在 2026-06-02 才执行归档
                </?01M02NT0W2JK6CDRA83D69FWCD>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/codument-must-support-long-term-decisions-registry" } (
      <Requirement #codument-must-support-long-term-decisions-registry (
        <Statement ?01M02NT0W2JK6CDRA83D69FWCE>
        系统应当（SHALL）支持 `codument/decisions/` 作为长期项目决策 registry。
        </?01M02NT0W2JK6CDRA83D69FWCE>
        <Suites [
          <Suite { name = "codument-must-support-long-term-decisions-registry" } (
            <Cases [
              <Case #durable-track-decision-is-promoted { name = "Durable track decision is promoted" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWCF>
                track 的 `decisions.md` 中存在对未来仍有约束力的决策
                </?01M02NT0W2JK6CDRA83D69FWCF>
                <When ?01M02NT0W2JK6CDRA83D69FWCG>
                track 归档
                </?01M02NT0W2JK6CDRA83D69FWCG>
                <Then ?01M02NT0W2JK6CDRA83D69FWCH>
                系统可将该决策提升到 `codument/decisions/YYYY-MM/YYYY-MM-DD-HHmm-slug/decision.md`
                该决策可以通过 `decision://...` 引用
                </?01M02NT0W2JK6CDRA83D69FWCH>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/codument-must-support-optional-project-memory" } (
      <Requirement #codument-must-support-optional-project-memory (
        <Statement ?01M02NT0W2JK6CDRA83D69FWCJ>
        系统应当（SHALL）在 `projectMemory.enabled=true` 时支持 `codument/memory/` 长期项目记忆。
        </?01M02NT0W2JK6CDRA83D69FWCJ>
        <Suites [
          <Suite { name = "codument-must-support-optional-project-memory" } (
            <Cases [
              <Case #memory-is-not-created-by-default { name = "Memory is not created by default" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWCK>
                `projectMemory.enabled=false`
                </?01M02NT0W2JK6CDRA83D69FWCK>
                <When ?01M02NT0W2JK6CDRA83D69FWCM>
                track 归档
                </?01M02NT0W2JK6CDRA83D69FWCM>
                <Then ?01M02NT0W2JK6CDRA83D69FWCN>
                系统不创建 `codument/memory/`
                不提升 memory
                </?01M02NT0W2JK6CDRA83D69FWCN>
              )>
              <Case #lesson-memory-is-promoted { name = "Lesson memory is promoted" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWCP>
                `projectMemory.enabled=true`
                </?01M02NT0W2JK6CDRA83D69FWCP>
                <When ?01M02NT0W2JK6CDRA83D69FWCQ>
                track 归档
                </?01M02NT0W2JK6CDRA83D69FWCQ>
                <Then ?01M02NT0W2JK6CDRA83D69FWCR>
                系统可创建 `codument/memory/lessons/YYYY-MM/YYYY-MM-DD-HHmm-slug/lesson.md`
                track 暴露了未来应避免的规则
                不创建 `codument/memory/index.md`
                </?01M02NT0W2JK6CDRA83D69FWCR>
              )>
              <Case #incident-memory-is-promoted { name = "Incident memory is promoted" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWCS>
                `projectMemory.enabled=true`
                </?01M02NT0W2JK6CDRA83D69FWCS>
                <When ?01M02NT0W2JK6CDRA83D69FWCT>
                track 归档
                </?01M02NT0W2JK6CDRA83D69FWCT>
                <Then ?01M02NT0W2JK6CDRA83D69FWCV>
                系统可创建 `codument/memory/incidents/YYYY-MM/YYYY-MM-DD-HHmm-slug/incident.md`
                track 记录了一次具体错误、根因和修复
                </?01M02NT0W2JK6CDRA83D69FWCV>
              )>
              <Case #pattern-memory-is-promoted { name = "Pattern memory is promoted" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWCW>
                `projectMemory.enabled=true`
                </?01M02NT0W2JK6CDRA83D69FWCW>
                <When ?01M02NT0W2JK6CDRA83D69FWCX>
                track 归档
                </?01M02NT0W2JK6CDRA83D69FWCX>
                <Then ?01M02NT0W2JK6CDRA83D69FWCY>
                系统可创建 `codument/memory/patterns/YYYY-MM/YYYY-MM-DD-HHmm-slug/pattern.md`
                track 产生了可复用工作模式
                </?01M02NT0W2JK6CDRA83D69FWCY>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/codument-must-support-configurable-knowledge-sync" } (
      <Requirement #codument-must-support-configurable-knowledge-sync (
        <Statement ?01M02NT0W2JK6CDRA83D69FWCZ>
        系统应当（SHALL）在 `knowledgeSync.enabled=true` 时，根据配置 target 和对应 attractor 同步 docs 或其他知识目录。
        </?01M02NT0W2JK6CDRA83D69FWCZ>
        <Suites [
          <Suite { name = "codument-must-support-configurable-knowledge-sync" } (
            <Cases [
              <Case #plan-includes-docs-sync-task-when-enabled { name = "Plan includes docs sync task when enabled" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWD0>
                `knowledgeSync.enabled=true`
                </?01M02NT0W2JK6CDRA83D69FWD0>
                <When ?01M02NT0W2JK6CDRA83D69FWD1>
                系统生成大型 track 的 `plan.xml`
                </?01M02NT0W2JK6CDRA83D69FWD1>
                <Then ?01M02NT0W2JK6CDRA83D69FWD2>
                计划包含知识同步任务
                任务要求读取 target 对应 attractor
                </?01M02NT0W2JK6CDRA83D69FWD2>
              )>
              <Case #no-docs-link-when-disabled { name = "No docs link when disabled" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWD3>
                `knowledgeSync.enabled=false`
                </?01M02NT0W2JK6CDRA83D69FWD3>
                <When ?01M02NT0W2JK6CDRA83D69FWD4>
                系统生成 spec XML 或 plan
                </?01M02NT0W2JK6CDRA83D69FWD4>
                <Then ?01M02NT0W2JK6CDRA83D69FWD5>
                不生成 `knowledge://` hint
                不要求更新 docs
                </?01M02NT0W2JK6CDRA83D69FWD5>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/codument-must-provide-manual-docs-lifecycle-skills" } (
      <Requirement #codument-must-provide-manual-docs-lifecycle-skills (
        <Statement ?01M02NT0W2JK6CDRA83D69FWD6>
        系统应当（SHALL）提供手动触发的 docs lifecycle skills，将项目知识同步到 `docs/modeling` 与 `docs/impl`，且不依赖 archive 自动流程。
        </?01M02NT0W2JK6CDRA83D69FWD6>
        <Suites [
          <Suite { name = "codument-must-provide-manual-docs-lifecycle-skills" } (
            <Cases [
              <Case #bootstrap-existing-project-docs { name = "Bootstrap existing project docs" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWD7>
                一个现存项目缺少符合 Codument docs fractal 规范的 `docs/modeling` 或 `docs/impl`
                </?01M02NT0W2JK6CDRA83D69FWD7>
                <When ?01M02NT0W2JK6CDRA83D69FWD8>
                用户触发 `codument-docs-bootstrap`
                </?01M02NT0W2JK6CDRA83D69FWD8>
                <Then ?01M02NT0W2JK6CDRA83D69FWD9>
                skill 指导 AI 读取项目结构、attractors、specs、README、代码与测试
                skill 指导 AI 创建或更新 `docs/modeling` 的领域/能力/行为模型文档
                skill 指导 AI 创建或更新 `docs/impl` 的实现结构、入口、数据流、运行和测试文档
                skill 要求保留不确定项为待确认事项，不把猜测写成事实
                </?01M02NT0W2JK6CDRA83D69FWD9>
              )>
              <Case #sync-a-specific-track-to-docs { name = "Sync a specific track to docs" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWDA>
                用户指定一个 active 或 archived track
                </?01M02NT0W2JK6CDRA83D69FWDA>
                <When ?01M02NT0W2JK6CDRA83D69FWDB>
                用户触发 `codument-docs-sync-track`
                </?01M02NT0W2JK6CDRA83D69FWDB>
                <Then ?01M02NT0W2JK6CDRA83D69FWDC>
                skill 指导 AI 读取该 track 的 proposal、spec delta、design、plan、archive summary 与相关 diff
                skill 指导 AI 仅同步该 track 造成的建模与实现变化到 `docs/modeling` 与 `docs/impl`
                skill 要求记录未同步原因或待确认事项
                </?01M02NT0W2JK6CDRA83D69FWDC>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/codument-must-provide-manual-legacy-migration-lifecycle-skills" } (
      <Requirement #codument-must-provide-manual-legacy-migration-lifecycle-skills (
        <Statement ?01M02NT0W2JK6CDRA83D69FWDD>
        系统应当（SHALL）提供手动触发的旧项目迁移 lifecycle skills，将旧 Codument archive 与 specs 逐步转换为新目录和文件规范。
        </?01M02NT0W2JK6CDRA83D69FWDD>
        <Suites [
          <Suite { name = "codument-must-provide-manual-legacy-migration-lifecycle-skills" } (
            <Cases [
              <Case #migrate-old-archive-layout { name = "Migrate old archive layout" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWDE>
                旧项目存在 `codument/archive/YYYY-MM-DD-track-id/` 或缺少 `plan.xml` 的归档目录
                </?01M02NT0W2JK6CDRA83D69FWDE>
                <When ?01M02NT0W2JK6CDRA83D69FWDF>
                用户触发 `codument-migrate-archive`
                </?01M02NT0W2JK6CDRA83D69FWDF>
                <Then ?01M02NT0W2JK6CDRA83D69FWDG>
                skill 指导 AI 建立备份或迁移记录
                skill 指导 AI 将归档目录转换为 `codument/archive/YYYY-MM/YYYY-MM-DD-HHmm-track-id/`
                skill 指导 AI 补齐可验证的 `plan.xml`、summary 与 legacy preservation 信息
                skill 不删除无法安全解释的旧内容
                </?01M02NT0W2JK6CDRA83D69FWDG>
              )>
              <Case #migrate-old-markdown-specs { name = "Migrate old Markdown specs" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWDH>
                旧项目存在 Markdown specs 或旧 `spec.md` delta
                </?01M02NT0W2JK6CDRA83D69FWDH>
                <When ?01M02NT0W2JK6CDRA83D69FWDJ>
                用户触发 `codument-migrate-specs`
                </?01M02NT0W2JK6CDRA83D69FWDJ>
                <Then ?01M02NT0W2JK6CDRA83D69FWDK>
                skill 指导 AI 将可安全迁移的 capability specs 转换为 XML spec registry
                skill 指导 AI 对大 capability 使用同名目录和 `index.xml`/`include`
                skill 指导 AI 将不安全转换的原文保留到 `codument/legacy/specs`
                skill 要求迁移后运行 validate/list/show 相关验证
                </?01M02NT0W2JK6CDRA83D69FWDK>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/codument-track-must-support-proposal-and-design-subdirectories-for-large-tracks" } (
      <Requirement #codument-track-must-support-proposal-and-design-subdirectories-for-large-tracks (
        <Statement ?01M02NT0W2JK6CDRA83D69FWDM>
        系统应当（SHALL）在创建设计点多、内容大的 track 时，允许并鼓励创建 `proposal/` 和 `design/` 子目录，根级 `proposal.md` 与 `design.md` 作为总览引用子文件。
        </?01M02NT0W2JK6CDRA83D69FWDM>
        <Suites [
          <Suite { name = "codument-track-must-support-proposal-and-design-subdirectories-for-large-tracks" } (
            <Cases [
              <Case #large-proposal-uses-proposal-directory { name = "Large proposal uses proposal directory" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWDN>
                track 背景、范围、兼容性或 rollout 内容较多
                </?01M02NT0W2JK6CDRA83D69FWDN>
                <When ?01M02NT0W2JK6CDRA83D69FWDP>
                AI 助手创建 proposal
                </?01M02NT0W2JK6CDRA83D69FWDP>
                <Then ?01M02NT0W2JK6CDRA83D69FWDQ>
                可以创建 `proposal/` 子目录
                `proposal.md` 引用子文件
                子文件位于当前 track 目录内
                </?01M02NT0W2JK6CDRA83D69FWDQ>
              )>
              <Case #large-design-uses-design-directory { name = "Large design uses design directory" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWDR>
                track 有多个子方向详细设计
                </?01M02NT0W2JK6CDRA83D69FWDR>
                <When ?01M02NT0W2JK6CDRA83D69FWDS>
                AI 助手创建 design
                </?01M02NT0W2JK6CDRA83D69FWDS>
                <Then ?01M02NT0W2JK6CDRA83D69FWDT>
                可以创建 `design/` 子目录
                `design.md` 引用子设计文件
                子文件位于当前 track 目录内
                </?01M02NT0W2JK6CDRA83D69FWDT>
              )>
              <Case #track-prompt-provides-good-bad-examples { name = "Track prompt provides good bad examples" } (
                <Given ?01M02NT0W2JK6CDRA83D69FWDV>
                AI 助手使用 codument-track 创建大型 track
                </?01M02NT0W2JK6CDRA83D69FWDV>
                <When ?01M02NT0W2JK6CDRA83D69FWDW>
                提示词说明 proposal/design 子目录规则
                </?01M02NT0W2JK6CDRA83D69FWDW>
                <Then ?01M02NT0W2JK6CDRA83D69FWDX>
                提示词包含 good examples
                提示词包含 bad examples
                </?01M02NT0W2JK6CDRA83D69FWDX>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/项目初始化命令" } (
      <Requirement { id = "项目初始化命令" } (
        <Statement ?01M02NT0W2JK6CDRA83D69FWDY>
        系统应当（SHALL）继续提供 `codument init` 命令，并调整新项目初始化的项目级上下文输出。
