<BehaviorPatch #track.r_2_0_2_6_-_0_7_-_2_5_-_2_2_1_3_-_a_d_d_-_m_i_s_s_i_o_n_-_a_c_t_o_r_-_s_e_t_s.behavior_patch.codument-core apiVersion="codument.tech/v1alpha1" version="1" { capability = "codument-core" } (
  <Mutations [
    <Upsert { selector = "behavior://codument-core/requirements/mission-standard-artifacts/suites/mission-artifacts/cases/default-design-and-decisions" } (
      <Case #default-design-and-decisions (
        <Given ?01M02NT0WKME5MXPMRNYXVK95F>
        系统创建一个新的 track 或 mission 规划目录。
        </?01M02NT0WKME5MXPMRNYXVK95F>
        <When ?01M02NT0WKME5MXPMRNYXVK95G>
        standard planning artifacts are generated。
        </?01M02NT0WKME5MXPMRNYXVK95G>
        <Then ?01M02NT0WKME5MXPMRNYXVK95H>
        系统 SHALL create `design.md` and `decisions.xnl` unconditionally。
        </?01M02NT0WKME5MXPMRNYXVK95H>
        <Ands [
          <And ?01M02NT0WKME5MXPMRNYXVK95J>
          系统 SHALL create `decisions/` and `memory/` only when they have eligible content。
          </?01M02NT0WKME5MXPMRNYXVK95J>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/mission-xml-spec/suites/mission-xml/cases/actor-sets-and-project-refs" } (
      <Case #actor-sets-and-project-refs (
        <Given ?01M02NT0WKME5MXPMRNYXVK95K>
        一个 mission requires concrete control work for one or more project contexts。
        </?01M02NT0WKME5MXPMRNYXVK95K>
        <When ?01M02NT0WKME5MXPMRNYXVK95M>
        its mission.xml is authored or validated。
        </?01M02NT0WKME5MXPMRNYXVK95M>
        <Then ?01M02NT0WKME5MXPMRNYXVK95N>
        系统 SHALL persist one complete default ActorSet with exactly MissionPlanner, MissionObserver, MissionReconciler, and MissionApplier。
        </?01M02NT0WKME5MXPMRNYXVK95N>
        <Ands [
          <And ?01M02NT0WKME5MXPMRNYXVK95P>
          每个 TaskGroup SHALL inherit that set or reference a complete local override。
          </?01M02NT0WKME5MXPMRNYXVK95P>
          <And ?01M02NT0WKME5MXPMRNYXVK95Q>
          系统 SHALL persist only path-free unique ProjectRef identities and reject unknown or duplicate references。
          </?01M02NT0WKME5MXPMRNYXVK95Q>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/mission-cybernetic-actors/suites/mission-actors/cases/actor-set-runtime-boundary" } (
      <Case #actor-set-runtime-boundary (
        <Given ?01M02NT0WKME5MXPMRNYXVK95R>
        一个 mission references an external ProjectRef or TrackLink。
        </?01M02NT0WKME5MXPMRNYXVK95R>
        <When ?01M02NT0WKME5MXPMRNYXVK95S>
        impl-mission observes and reconciles actual state。
        </?01M02NT0WKME5MXPMRNYXVK95S>
        <Then ?01M02NT0WKME5MXPMRNYXVK95T>
        系统 SHALL resolve workspace paths only through session-local WorkspaceBinding and SHALL NOT persist those paths。
        </?01M02NT0WKME5MXPMRNYXVK95T>
        <Ands [
          <And ?01M02NT0WKME5MXPMRNYXVK95V>
          缺少 binding SHALL project UNBOUND rather than candidate, missing, or persistent Mission state。
          </?01M02NT0WKME5MXPMRNYXVK95V>
          <And ?01M02NT0WKME5MXPMRNYXVK95W>
          binding exists but an external track is absent SHALL project MISSING from the target project actual state。
          </?01M02NT0WKME5MXPMRNYXVK95W>
          <And ?01M02NT0WKME5MXPMRNYXVK95X>
          无关 DAG branches SHALL remain eligible when they do not depend on an UNBOUND ProjectRef。
          </?01M02NT0WKME5MXPMRNYXVK95X>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/mission-operations/suites/mission-ops/cases/actor-set-and-feedback-examples" } (
      <Case #actor-set-and-feedback-examples (
        <Given ?01M02NT0WKME5MXPMRNYXVK95Y>
        用户创建或执行一个 mission with ActorSets and external ProjectRefs。
        </?01M02NT0WKME5MXPMRNYXVK95Y>
        <When ?01M02NT0WKME5MXPMRNYXVK95Z>
        plan-mission, impl-mission, and the Mission XML spec describe the workflow。
        </?01M02NT0WKME5MXPMRNYXVK95Z>
        <Then ?01M02NT0WKME5MXPMRNYXVK960>
        系统 SHALL describe session WorkspaceBinding, external TrackLink observation, UNBOUND recovery, and complete ActorSet override semantics。
        </?01M02NT0WKME5MXPMRNYXVK960>
        <Ands [
          <And ?01M02NT0WKME5MXPMRNYXVK961>
          系统 SHALL provide one single-project feedback loop and one bottom-library/top-application two-project feedback loop example without absolute paths。
          </?01M02NT0WKME5MXPMRNYXVK961>
        ]>
      )>
    )>
  ]>
)>
