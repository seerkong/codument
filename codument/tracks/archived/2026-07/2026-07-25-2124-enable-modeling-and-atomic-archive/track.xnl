<Track #enable-modeling-and-atomic-archive apiVersion="codument.tech/v1alpha1" version="1" { status = "completed" goal = "默认启用 modeling，并让 behavior/modeling/engineering 通过原子归档事务共同收敛" description = "接入 modeling 三方合并、调整空 registry 语义，并建立跨 registry prepare/stage/commit/rollback 边界。" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-07-25T17:58:56+03:00" updated_at = "2026-07-25T21:24:43+03:00" } (
