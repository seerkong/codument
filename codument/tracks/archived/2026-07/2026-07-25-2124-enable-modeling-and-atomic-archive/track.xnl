          <Task { id = "T1.1" name = "编写 modeling 默认值与空 registry 红测试" status = "DONE" order = 0 priority = "P0" } (
            <Description ?01M02JDH9HKDSBVMX5Y1DTVMY3>
            覆盖缺失配置默认 true、显式 false、模板 true、空 registry warning 和非空无 domain error。
            </?01M02JDH9HKDSBVMX5Y1DTVMY3>
            <Acceptance [
              <Criterion { id = "T1.1-AC1" checked = true } ?01M02JDH9HKDSBVMX5Y1DTVMY4>
