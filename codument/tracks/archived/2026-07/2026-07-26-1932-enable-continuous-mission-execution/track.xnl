          <Task #P1-T2 { name = "更新 Mission XML 规范和 skill 描述" status = "DONE" order = 1 }>
        ]>
      )>
      <TaskGroup #P2 { name = "回归验证与 dogfood" status = "DONE" order = 1 } (
        <SubNodes [
          <Task #P2-T1 { name = "增加连续执行提示词回归测试" status = "DONE" order = 0 }>
          <Task #P2-T2 { name = "构建并升级当前工作区" status = "DONE" order = 1 }>
        ]>
      )>
      <TaskGroup #P3 { name = "验证驱动的连续推进" status = "DONE" order = 2 } (
        <SubNodes [
          <Task #P3-T1 { name = "修订动作验证与条件观察契约" status = "DONE" order = 0 }>
