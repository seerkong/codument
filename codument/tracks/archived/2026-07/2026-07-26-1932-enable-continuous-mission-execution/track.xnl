<Track #enable-continuous-mission-execution apiVersion="codument.tech/v1alpha1" version="1" { status = "completed" goal = "让 mission 从启动开始连续执行，以动作内验证驱动推进，并以十条 track 为单次运行上限。" description = "移除 mission 的 start-only、bounded-action 和每动作强制全量收敛语义，统一提示词、行为契约、规范和回归测试。" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-07-26T00:00:00Z" updated_at = "2026-07-26T19:32:28+03:00" } (
  <Ports { scope = "track" } [
    <MaterialBundle { role = "input" name = "mission-templates" domain = "code" path = "vfs://@/src/templates/" }>
    <MaterialBundle { role = "input" name = "behavior" domain = "behavior" path = "vfs://@/codument/behaviors/" }>
    <MaterialBundle { role = "output" name = "templates" domain = "code" path = "vfs://@/src/templates/" }>
    <MaterialBundle { role = "output" name = "tests" domain = "test" path = "vfs://@/test/" }>
  ]>
  <TaskSpace #space_enable-continuous-mission-execution { name = "enable-continuous-mission-execution" } (
    <SubNodes [
      <TaskGroup #P1 { name = "连续执行契约" status = "DONE" order = 0 } (
