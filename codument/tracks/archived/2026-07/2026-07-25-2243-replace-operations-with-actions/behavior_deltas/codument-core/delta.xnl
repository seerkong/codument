<BehaviorPatch #track.r_2_0_2_6_-_0_7_-_2_5_-_2_2_4_3_-_r_e_p_l_a_c_e_-_o_p_e_r_a_t_i_o_n_s_-_w_i_t_h_-_a_c_t_i_o_n_s.behavior_patch.codument-core apiVersion="codument.tech/v1alpha1" version="1" { capability = "codument-core" } (
  <Mutations [
    <Upsert { selector = "behavior://codument-core/requirements/action-taxonomy" } (
      <Requirement #action-taxonomy (
        <Statement ?01M02NT0WMPFS48SE0P5X90C15>
        系统 SHALL expose actions rather than operations in its release surface, while retaining old names only in explicit compat and migration boundaries.
        </?01M02NT0WMPFS48SE0P5X90C15>
        <Suites [
          <Suite #taxonomy { name = "Action taxonomy" } (
            <Cases [
              <Case #workspace-upgrade (
                <Given ?01M02NT0WMPFS48SE0P5X90C16>
                旧 workspace contains operation paths or hooks
                </?01M02NT0WMPFS48SE0P5X90C16>
                <When ?01M02NT0WMPFS48SE0P5X90C17>
                upgrade-workspace runs
                </?01M02NT0WMPFS48SE0P5X90C17>
                <Then ?01M02NT0WMPFS48SE0P5X90C18>
                系统 SHALL migrate supported configuration and remove deprecated managed paths after backup
                </?01M02NT0WMPFS48SE0P5X90C18>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
