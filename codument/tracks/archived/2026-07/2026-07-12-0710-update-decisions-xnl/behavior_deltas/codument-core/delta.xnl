<BehaviorPatch #track.update-decisions-xnl.behavior_patch.codument-core apiVersion="codument.tech/v1alpha1" version="1" { capability = "codument-core" } (
  <Mutations [
    <Upsert { selector = "behavior://codument-core/requirements/decision-xnl-carrier" } (
      <Requirement #decision-xnl-carrier (
        <Statement ?01M02NT0VGGEW9W1ZK6X4MZ823>
        Codument SHALL use `decisions.xnl` as the default carrier for track and mission process decisions.
        </?01M02NT0VGGEW9W1ZK6X4MZ823>
        <Suites [
          <Suite #authoring { name = "决策记录生成" } (
            <Cases [
              <Case #plan-track-creates-decisions-xnl (
                <Given ?01M02NT0VGGEW9W1ZK6X4MZ824>
                用户创建一个需要过程决策或 DSL review 的 track
                </?01M02NT0VGGEW9W1ZK6X4MZ824>
                <When ?01M02NT0VGGEW9W1ZK6X4MZ825>
                codument-plan-track 生成决策记录入口
                </?01M02NT0VGGEW9W1ZK6X4MZ825>
                <Then ?01M02NT0VGGEW9W1ZK6X4MZ826>
                系统 SHALL create `decisions.xnl` rather than root `decisions.md`
                </?01M02NT0VGGEW9W1ZK6X4MZ826>
                <Ands [
                  <And ?01M02NT0VGGEW9W1ZK6X4MZ827>
                  系统 SHALL put normal node properties in XNL `{}` attributes rather than metadata
                  </?01M02NT0VGGEW9W1ZK6X4MZ827>
                ]>
              )>
              <Case #decision-tree-uses-nesting (
                <Given ?01M02NT0VGGEW9W1ZK6X4MZ828>
                规划过程包含决策树
                </?01M02NT0VGGEW9W1ZK6X4MZ828>
                <When ?01M02NT0VGGEW9W1ZK6X4MZ829>
                系统写入决策树载体
                </?01M02NT0VGGEW9W1ZK6X4MZ829>
                <Then ?01M02NT0VGGEW9W1ZK6X4MZ82A>
                系统 SHALL represent parent-child decision relationships with nested XNL nodes
                </?01M02NT0VGGEW9W1ZK6X4MZ82A>
              )>
              <Case #decision-options-use-wrapper (
                <Given ?01M02NT0VGGEW9W1ZK6X4MZ82B>
                一个新决策点需要用户在多个候选方案中选择
                </?01M02NT0VGGEW9W1ZK6X4MZ82B>
                <When ?01M02NT0VGGEW9W1ZK6X4MZ82C>
                系统写入或展示 decisions.xnl
                </?01M02NT0VGGEW9W1ZK6X4MZ82C>
                <Then ?01M02NT0VGGEW9W1ZK6X4MZ82D>
                系统 SHALL write exactly one &lt;options&gt; singleton under the decision's extend block
                </?01M02NT0VGGEW9W1ZK6X4MZ82D>
                <Ands [
                  <And ?01M02NT0VGGEW9W1ZK6X4MZ82E>
                  系统 SHALL write repeated &lt;option&gt; nodes inside the &lt;options&gt; node's array block
                  </?01M02NT0VGGEW9W1ZK6X4MZ82E>
                  <And ?01M02NT0VGGEW9W1ZK6X4MZ82F>
                  系统 SHALL keep the decision's own array block reserved for nested child decisions
                  </?01M02NT0VGGEW9W1ZK6X4MZ82F>
                  <And ?01M02NT0VGGEW9W1ZK6X4MZ82G>
                  each option SHALL include a title and detailed description
                  </?01M02NT0VGGEW9W1ZK6X4MZ82G>
                  <And ?01M02NT0VGGEW9W1ZK6X4MZ82H>
                  exactly one option SHALL be marked recommended=true when a recommendation is available
                  </?01M02NT0VGGEW9W1ZK6X4MZ82H>
                ]>
              )>
              <Case #decision-answer-feedback-wrapper (
                <Given ?01M02NT0VGGEW9W1ZK6X4MZ82J>
                一个 decision 需要记录参与者回答以及回答后的整理信息
                </?01M02NT0VGGEW9W1ZK6X4MZ82J>
                <When ?01M02NT0VGGEW9W1ZK6X4MZ82K>
                系统写入 decisions.xnl
                </?01M02NT0VGGEW9W1ZK6X4MZ82K>
                <Then ?01M02NT0VGGEW9W1ZK6X4MZ82M>
                系统 SHALL use exactly one &lt;answer&gt; container for answer feedback
                </?01M02NT0VGGEW9W1ZK6X4MZ82M>
                <Ands [
                  <And ?01M02NT0VGGEW9W1ZK6X4MZ82N>
                  系统 SHALL write the original response as &lt;raw-answer&gt; under &lt;answer&gt;
                  </?01M02NT0VGGEW9W1ZK6X4MZ82N>
                  <And ?01M02NT0VGGEW9W1ZK6X4MZ82P>
                  系统 SHALL write &lt;decision-text&gt;, &lt;rationale&gt; and &lt;evidence&gt; under the same &lt;answer&gt;
                  </?01M02NT0VGGEW9W1ZK6X4MZ82P>
                  <And ?01M02NT0VGGEW9W1ZK6X4MZ82Q>
                  系统 SHALL keep reading legacy direct &lt;answer&gt; text nodes
                  </?01M02NT0VGGEW9W1ZK6X4MZ82Q>
                ]>
              )>
            ]>
          )>
          <Suite #validation { name = "决策校验" } (
            <Cases [
              <Case #validate-track-prefers-xnl (
                <Given ?01M02NT0VGGEW9W1ZK6X4MZ82R>
                track 目录同时存在 `decisions.xnl` 与 legacy `decisions.md`
                </?01M02NT0VGGEW9W1ZK6X4MZ82R>
                <When ?01M02NT0VGGEW9W1ZK6X4MZ82S>
                用户运行 `codument decisions validate &lt;track-id&gt;`
                </?01M02NT0VGGEW9W1ZK6X4MZ82S>
                <Then ?01M02NT0VGGEW9W1ZK6X4MZ82T>
                系统 SHALL validate `decisions.xnl` as the canonical carrier
                </?01M02NT0VGGEW9W1ZK6X4MZ82T>
                <Ands [
                  <And ?01M02NT0VGGEW9W1ZK6X4MZ82V>
                  系统 SHALL only use `decisions.md` as legacy fallback when `decisions.xnl` is absent
                  </?01M02NT0VGGEW9W1ZK6X4MZ82V>
                ]>
              )>
              <Case #pending-blocks-validation (
                <Given ?01M02NT0VGGEW9W1ZK6X4MZ82W>
                `decisions.xnl` 中存在 status="pending" 且 blocks 非空的 decision
                </?01M02NT0VGGEW9W1ZK6X4MZ82W>
                <When ?01M02NT0VGGEW9W1ZK6X4MZ82X>
                用户运行 `codument decisions validate`
                </?01M02NT0VGGEW9W1ZK6X4MZ82X>
                <Then ?01M02NT0VGGEW9W1ZK6X4MZ82Y>
                系统 SHALL report an error for the unresolved blocking decision
                </?01M02NT0VGGEW9W1ZK6X4MZ82Y>
              )>
            ]>
          )>
          <Suite #archive { name = "归档提升" } (
            <Cases [
              <Case #archive-promotes-durable-xnl (
                <Given ?01M02NT0VGGEW9W1ZK6X4MZ82Z>
                archived track 的 `decisions.xnl` 中存在 durable_candidate=true 且 status="accepted" 的 decision
                </?01M02NT0VGGEW9W1ZK6X4MZ82Z>
                <When ?01M02NT0VGGEW9W1ZK6X4MZ830>
                用户归档 track
                </?01M02NT0VGGEW9W1ZK6X4MZ830>
                <Then ?01M02NT0VGGEW9W1ZK6X4MZ831>
                系统 SHALL be able to promote the durable decision to `codument/decisions/`
                </?01M02NT0VGGEW9W1ZK6X4MZ831>
                <Ands [
                  <And ?01M02NT0VGGEW9W1ZK6X4MZ832>
                  系统 SHALL keep legacy `decisions.md` promotion readable for historical archives
                  </?01M02NT0VGGEW9W1ZK6X4MZ832>
                ]>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
