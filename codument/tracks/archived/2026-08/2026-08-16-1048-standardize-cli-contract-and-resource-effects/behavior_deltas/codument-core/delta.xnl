<BehaviorPatch #track.standardize-cli-contract-and-resource-effects.behavior_patch.codument-core apiVersion="codument.tech/v1alpha1" version="1" { capability = "codument-core" } (
  <Mutations [
    <Upsert { selector = "behavior://codument-core/requirements/cli-leaf-command-contract" } (
      <Requirement #cli-leaf-command-contract (
        <Statement ?>Codument SHALL execute every CLI leaf command through one context, result, schema, and documentation contract.</?>
        <Suites [
          <Suite #leaf-protocol { name = "CLI leaf protocol" } (
            <Cases [
              <Case #complete-contract (
                <Given ?>任意注册到嵌套命令树的叶命令</?>
                <When ?>命令注册表接受该叶节点</?>
                <Then ?>节点 SHALL 声明 schema、doc 与接收 CommandContext 并返回 CommandResult 的 run</?>
              )>
              <Case #help-short-circuit (
                <Given ?>任意命令路径携带 -h 或 --help</?>
                <When ?>CLI 分发请求</?>
                <Then ?>CLI SHALL 在构造执行 runtime、校验 schema 或调用 run 前返回帮助</?>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/packaged-resource-effects" } (
      <Requirement #packaged-resource-effects (
        <Statement ?>Codument SHALL expose distributed templates, skills, operations, and KindDefinitions through a read-only ResourceEffect distinct from writable WorkspaceEffect.</?>
        <Suites [
          <Suite #resource-boundaries { name = "Published resource boundaries" } (
            <Cases [
              <Case #read-only-authority (
                <Given ?>CLI 读取随版本发布的资源</?>
                <When ?>访问 template、skill、operation 或 KindDefinition</?>
                <Then ?>ResourceEffect SHALL 只提供 stat、readDirectory 与 readText，不提供 mutation</?>
              )>
              <Case #workspace-mutation (
                <Given ?>init 或 upgrade 需要写入 workspace 或 agent skills 目录</?>
                <When ?>安装器执行文件变更</?>
                <Then ?>mutation SHALL 通过以目标目录为根的 WorkspaceEffect 执行</?>
              )>
              <Case #adapter-parity (
                <Given ?>相同的发布资源集合位于源码目录或 Bun embedded files</?>
                <When ?>调用同一 ResourceEffect contract</?>
                <Then ?>两个适配器 SHALL 返回一致的逻辑路径、目录项和文本内容</?>
              )>
              <Case #compiled-init (
                <Given ?>不依赖源码模板目录的单文件 CLI</?>
                <When ?>在空 workspace 运行 init</?>
                <Then ?>CLI SHALL 从 embedded resources 完整安装受管 workspace 与 skill 文件</?>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
