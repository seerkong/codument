<BehaviorPatch #track.tracklink-mission-context.behavior_patch.tracklink-context apiVersion="codument.tech/v1alpha1" version="1" { capability = "tracklink-context" } (
  <Mutations [
    <Upsert { selector = "behavior://tracklink-context/requirements/mission-ref" } (
      <Requirement #mission-ref (
        <Statement ?>TrackLink SHALL explicitly identify its Mission context with mission_ref; a cross-layer TrackLink SHALL also identify the concrete Track with track_ref; the child Mission SHALL remain the sole Track lifecycle owner</?>
        <Suites [
          <Suite #tracklink-context-suite { name = "TrackLink mission context" } (
            <Cases [
              <Case #cross-layer-owner (
                <Given ?>a parent Mission references a Track in a child Mission</?>
                <When ?>the parent reconciles the TrackLink</?>
                <Then ?>the reference SHALL resolve project_ref, mission_ref and track_ref without creating a second Track owner</?>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
