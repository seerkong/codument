<Track #fix-spec-validator-conflicts apiVersion="codument.tech/v1alpha1" version="1" { status = "completed" goal = "修复规范声明 / 示例 / CLI 校验器之间的格式与规则冲突（审查发现的冲突 1~8），并把确定性校验规则下沉到 CLI 实现" description = "统一 track/mission/decisions/modeling 的规范、示例与校验器：修正 track-xml-spec 示例（TODO、Dag 引用）、补齐 mission 校验、调整 decisions pending 规则、补齐 modeling 最小表征校验、严格化 on-exhausted、规范示例进防回归 fixture、更新 README-cn 与 docs 遗留格式。" question_mode = "decision-tree" question_severity = "light" commit_mode = "manual" created_at = "2026-08-13T22:19:31Z" updated_at = "2026-08-14T03:30:00Z" } (
