    <MaterialBundle #tests { role = "output" name = "tests" domain = "test" path = "vfs://@/test/" }>
    <MaterialBundle #e2e { role = "output" name = "e2e" domain = "test" path = "vfs://@/e2e/project-implementation/" }>
  ]>
  <TaskSpace #space_harden-track-execution-integrity { name = "harden-track-execution-integrity" version = "1" child_mode = "dag" } (
    <SubNodes [
      <TaskGroup #P1 { name = "Lifecycle truth boundary" status = "DONE" priority = "P0" order = 0 } (
        <Description ?01M04HNTR8FKDABCHNQ913REAC>
        让验证、Criterion 与 lifecycle 状态在 CLI 内形成一致的原子边界。
        </?01M04HNTR8FKDABCHNQ913REAC>
        <SubNodes [
          <Task #P1-T1 { name = "增加验证后原子完成命令" status = "DONE" priority = "P0" order = 0 } (
            <Description ?01M04HNTR8FKDABCHNQ913READ>
            实现 track task complete，并拒绝通用 transition 绕过验证写入 DONE。
            </?01M04HNTR8FKDABCHNQ913READ>
            <Acceptance [
              <Criterion #P1-T1-AC1 { checked = true } ?01M04HNTR8FKDABCHNQ913REAE>
              验证命令退出非 0 或无法启动时，任务状态和 Criterion 均保持不变。
              </?01M04HNTR8FKDABCHNQ913REAE>
              <Criterion #P1-T1-AC2 { checked = true } ?01M04HNTR8FKDABCHNQ913REAF>
              验证退出 0 后，任务原子进入 DONE，CLI help 和 JSON receipt 可用。
              </?01M04HNTR8FKDABCHNQ913REAF>
            ]>
          )>
          <Task #P1-T2 { name = "修复 Criterion 遍历与完成一致性门" status = "DONE" priority = "P0" order = 1 } (
            <Description ?01M04HNTR8FKDABCHNQ913REAG>
            支持 TextElement Criterion、TaskGroup Gate、父组汇总和 completed strict gate。
            </?01M04HNTR8FKDABCHNQ913REAG>
            <Acceptance [
              <Criterion #P1-T2-AC1 { checked = true } ?01M04HNTR8FKDABCHNQ913REAH>
              真实 XNL Acceptance/Gate 会被正确更新，父 TaskGroup 只在可证明时自动汇总。
              </?01M04HNTR8FKDABCHNQ913REAH>
              <Criterion #P1-T2-AC2 { checked = true } ?01M04HNTR8FKDABCHNQ913REAJ>
              completed transition 和 strict validation 均拒绝未勾选 Acceptance/Gate。
              </?01M04HNTR8FKDABCHNQ913REAJ>
            ]>
          )>
        ]>
        <Gate [
          <Criterion #P1-G1 { checked = true } ?01M04HNTR8FKDABCHNQ913REAK>
          生命周期集成回归证明失败验证不会产生 DONE，完成态不存在 unchecked criterion。
          </?01M04HNTR8FKDABCHNQ913REAK>
        ]>
      )>
      <TaskGroup #P2 { name = "Compact execution interface" status = "DONE" priority = "P1" order = 1 } (
        <Description ?01M04HNTR8FKDABCHNQ913REAM>
        减少 Agent 为观察和推进 Track 所需的正文加载、命令数量和重复验证。
        </?01M04HNTR8FKDABCHNQ913REAM>
        <SubNodes [
          <Task #P2-T1 { name = "增加紧凑 show 和 ready 查询" status = "DONE" priority = "P1" order = 0 } (
            <Acceptance [
              <Criterion #P2-T1-AC1 { checked = true } ?01M04HNTR8FKDABCHNQ913REAN>
