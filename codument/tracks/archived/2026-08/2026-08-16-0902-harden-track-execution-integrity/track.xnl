              </?01M04HNTR8FKDABCHNQ913REAP>
            ]>
          )>
          <Task #P2-T2 { name = "让 verify 复用唯一证据命令" status = "DONE" priority = "P1" order = 1 } (
            <Acceptance [
              <Criterion #P2-T2-AC1 { checked = true } ?01M04HNTR8FKDABCHNQ913REAQ>
