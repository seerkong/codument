              </?01M04HNTR8FKDABCHNQ913REAW>
            ]>
          )>
          <Task #P3-T2 { name = "运行定向与全量验证" status = "DONE" priority = "P0" order = 1 } (
            <Acceptance [
              <Criterion #P3-T2-AC1 { checked = true } ?01M04HNTR8FKDABCHNQ913REAX>
              lifecycle、show、validate、template 和 E2E shell 测试全部通过。
              </?01M04HNTR8FKDABCHNQ913REAX>
              <Criterion #P3-T2-AC2 { checked = true } ?01M04HNTR8FKDABCHNQ913REAY>
              typecheck、std lint、全量 bun test 和 git diff --check 通过。
              </?01M04HNTR8FKDABCHNQ913REAY>
            ]>
          )>
        ]>
        <Gate [
          <Criterion #P3-G1 { checked = true } ?01M04HNTR8FKDABCHNQ913REAZ>
          构建产物、CLI help、严格校验与完整测试共同证明 Track 可收口。
          </?01M04HNTR8FKDABCHNQ913REAZ>
        ]>
      )>
    ]>
  )>
  <Schedule [
    <Dag { for = "space_harden-track-execution-integrity" } [
