            ]>
          )>
        ]>
        <Gate [
          <Criterion #P2-G1 { checked = true } ?01M04HNTR8FKDABCHNQ913REAS>
          CLI 查询和 verify 指令在保持完整裁决的同时减少重复内容与重复执行。
          </?01M04HNTR8FKDABCHNQ913REAS>
        ]>
      )>
      <TaskGroup #P3 { name = "E2E provenance and regression" status = "DONE" priority = "P1" order = 2 } (
        <Description ?01M04HNTR8FKDABCHNQ913REAT>
