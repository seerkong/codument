<Track #harden-track-execution-integrity apiVersion="codument.tech/v1alpha1" version="1" { status = "completed" goal = "让 Track 完成状态由可复现验证支撑，并减少 Agent 执行中的冗余上下文和状态操作。" description = "增加验证后原子完成、验收一致性门、紧凑查询、verify 证据复用和 E2E CLI provenance。" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-16T05:43:06.785Z" updated_at = "2026-08-16T06:02:47.899Z" modeling_base_commit = "f4a7e810e35e05b7565233808a8bcb9687a05942" engineering_base_commit = "f4a7e810e35e05b7565233808a8bcb9687a05942" } (
  <Ports { scope = "track" } [
