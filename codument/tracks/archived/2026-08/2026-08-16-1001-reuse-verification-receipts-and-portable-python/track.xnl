<Track #reuse-verification-receipts-and-portable-python apiVersion="codument.tech/v1alpha1" version="1" { status = "completed" goal = "让验证事实可在 Track gate 间安全复用，并让真实开发 E2E 可迁移地选择 Python 环境。" description = "增加内容指纹约束的 CLI 验证回执、fresh 边界和不绑定 Python 次版本的 E2E 环境发现。" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-16T06:48:23.795Z" updated_at = "2026-08-16T07:01:55.166Z" modeling_base_commit = "f4a7e810e35e05b7565233808a8bcb9687a05942" engineering_base_commit = "f4a7e810e35e05b7565233808a8bcb9687a05942" } (
