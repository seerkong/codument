    <MaterialBundle { role = "output" name = "templates" domain = "code" path = "vfs://@/src/templates/" }>
    <MaterialBundle { role = "output" name = "tests" domain = "test" path = "vfs://@/test/" }>
  ]>
  <TaskSpace #space_close-mission-execution-stop-points { name = "close-mission-execution-stop-points" } (
