    <MaterialBundle #tests { role = "output" name = "migration-regression-tests" domain = "test" path = "vfs://@/test/" }>
  ]>
  <TaskSpace #space_add-autonomous-workspace-migration { name = "add-autonomous-workspace-migration" version = "1" child_mode = "dag" } (
    <SubNodes [
