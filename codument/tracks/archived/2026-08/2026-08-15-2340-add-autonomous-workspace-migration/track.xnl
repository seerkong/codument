        <SubNodes [
          <Task #P1-T1 { name = "Refactor workspace upgrade into a JSON-capable receipt" status = "DONE" priority = "P0" order = 0 }>
          <Task #P1-T2 { name = "Add JSON and help regression tests" status = "DONE" priority = "P0" order = 1 }>
        ]>
      )>
      <TaskGroup #P2 { name = "Autonomous migrate Skill" status = "DONE" priority = "P0" order = 1 } (
        <SubNodes [
