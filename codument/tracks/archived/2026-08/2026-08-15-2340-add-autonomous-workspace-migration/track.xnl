<Track #add-autonomous-workspace-migration apiVersion="codument.tech/v1alpha1" version="1" { status = "completed" goal = "让一次 codument-migrate Skill 调用自主完成完整 workspace 或单资源升级" description = "增加 workspace JSON receipt，并让当前 Coding Agent 连续处理 review-required、语义复核和最终验证" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-15T20:29:33.574Z" updated_at = "2026-08-15T20:40:30.794Z" modeling_base_commit = "f4a7e810e35e05b7565233808a8bcb9687a05942" engineering_base_commit = "f4a7e810e35e05b7565233808a8bcb9687a05942" } (
  <Ports { scope = "track" } [
