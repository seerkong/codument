<BehaviorPatch #track.r_2_0_2_6_-_0_4_-_1_1_-_0_8_0_0_-_r_e_f_a_c_t_o_r_-_m_u_l_t_i_-_t_a_r_g_e_t_-_w_o_r_k_f_l_o_w_-_s_k_i_l_l_s.behavior_patch.codument-core apiVersion="codument.tech/v1alpha1" version="1" { capability = "codument-core" } (
  <Mutations [
    <Upsert { selector = "behavior://codument-core/requirements/codument-workflow-产物分发模型" } (
      <Requirement { id = "codument-workflow-产物分发模型" } (
        <Statement ?01M02NT0VZCA7Q38V7ZP4HHEHD>
        系统应当（SHALL）以统一的 `codument-workflow` skill 结构作为多 target 工作流分发基线，而不是只为部分 target 生成 skill、为其他 target 维持独立 command prompt 副本。
        </?01M02NT0VZCA7Q38V7ZP4HHEHD>
        <Suites [
          <Suite { name = "codument-workflow-产物分发模型" } (
            <Cases [
              <Case { id = "所有受支持-target-都获得-codument-workflow-skill-目录" name = "所有受支持 target 都获得 codument-workflow skill 目录" } (
                <Given ?01M02NT0VZCA7Q38V7ZP4HHEHE>
                用户运行 `codument init`
                </?01M02NT0VZCA7Q38V7ZP4HHEHE>
                <When ?01M02NT0VZCA7Q38V7ZP4HHEHF>
                用户选择任意受支持的 AI coding target
                </?01M02NT0VZCA7Q38V7ZP4HHEHF>
                <Then ?01M02NT0VZCA7Q38V7ZP4HHEHG>
                系统为该 target 生成 `codument-workflow` 对应的 skill 目录
                该 skill 目录至少包含根 skill 入口与生命周期 sub-skill 产物
                </?01M02NT0VZCA7Q38V7ZP4HHEHG>
              )>
              <Case { id = "command-型-target-同时保留-command-入口" name = "command 型 target 同时保留 command 入口" } (
                <Given ?01M02NT0VZCA7Q38V7ZP4HHEHH>
                用户选择的 target 同时支持 command 入口
                </?01M02NT0VZCA7Q38V7ZP4HHEHH>
                <When ?01M02NT0VZCA7Q38V7ZP4HHEHJ>
                系统生成该 target 的工作流产物
                </?01M02NT0VZCA7Q38V7ZP4HHEHJ>
                <Then ?01M02NT0VZCA7Q38V7ZP4HHEHK>
                系统仍生成该 target 既有的 command 目录
                command 内容引用同一次生成的 `codument-workflow` skill sub-skill
                command 不再内嵌一份独立维护的完整生命周期 prompt 副本
                </?01M02NT0VZCA7Q38V7ZP4HHEHK>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/codument-workflow-skill-基于公共模板和-target-适配生成" } (
      <Requirement { id = "codument-workflow-skill-基于公共模板和-target-适配生成" } (
        <Statement ?01M02NT0VZCA7Q38V7ZP4HHEHM>
        系统应当（SHALL）从同一套公共 skill 模板生成 Codex、Sparrow 及其他 target 的 workflow skill，并通过显式 target 适配层补充差异，而不是先生成某一个 target 的版本后再做字符串替换。
        </?01M02NT0VZCA7Q38V7ZP4HHEHM>
        <Suites [
          <Suite { name = "codument-workflow-skill-基于公共模板和-target-适配生成" } (
            <Cases [
              <Case { id = "调整公共-gap-loop-文案时不需要改动另一个-target-的替换逻辑" name = "调整公共 gap-loop 文案时不需要改动另一个 target 的替换逻辑" } (
                <Given ?01M02NT0VZCA7Q38V7ZP4HHEHN>
                维护者需要修改公共 gap-loop / implement / execute-wave 提示词
                </?01M02NT0VZCA7Q38V7ZP4HHEHN>
                <When ?01M02NT0VZCA7Q38V7ZP4HHEHP>
                维护者仅修改公共 skill 模板源
                </?01M02NT0VZCA7Q38V7ZP4HHEHP>
                <Then ?01M02NT0VZCA7Q38V7ZP4HHEHQ>
                其他 target 的生成逻辑不依赖对完整句子做字符串替换
                不要求同时修改“把 Codex 文案替换成 Sparrow 文案”一类的耦合代码
                </?01M02NT0VZCA7Q38V7ZP4HHEHQ>
              )>
              <Case { id = "sparrow-差异通过显式-target-profile-表达" name = "Sparrow 差异通过显式 target profile 表达" } (
                <Given ?01M02NT0VZCA7Q38V7ZP4HHEHR>
                Sparrow 需要 `manifest` 或 `task` 等 target-specific 约束
                </?01M02NT0VZCA7Q38V7ZP4HHEHR>
                <When ?01M02NT0VZCA7Q38V7ZP4HHEHS>
                系统生成 Sparrow skill
                </?01M02NT0VZCA7Q38V7ZP4HHEHS>
                <Then ?01M02NT0VZCA7Q38V7ZP4HHEHT>
                这些差异由 Sparrow 的 target profile / adaptor 显式提供
                不以“先复制 Codex 产物再按句子替换”的方式实现
                </?01M02NT0VZCA7Q38V7ZP4HHEHT>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/codument-workflow-skill-采用-root-skill-sub-skill-结构" } (
      <Requirement { id = "codument-workflow-skill-采用-root-skill-sub-skill-结构" } (
        <Statement ?01M02NT0VZCA7Q38V7ZP4HHEHV>
        系统应当（SHALL）把 Codument 生命周期工作流拆成可复用的 sub-skill 单元，以便 skill 型和 command 型 target 共享同一套工作流事实源。
        </?01M02NT0VZCA7Q38V7ZP4HHEHV>
        <Suites [
          <Suite { name = "codument-workflow-skill-采用-root-skill-sub-skill-结构" } (
            <Cases [
              <Case { id = "生命周期步骤可作为独立-sub-skill-被引用" name = "生命周期步骤可作为独立 sub-skill 被引用" } (
                <Given ?01M02NT0VZCA7Q38V7ZP4HHEHW>
                系统生成 `codument-workflow`
                </?01M02NT0VZCA7Q38V7ZP4HHEHW>
                <When ?01M02NT0VZCA7Q38V7ZP4HHEHX>
                用户检查 skill 目录
                </?01M02NT0VZCA7Q38V7ZP4HHEHX>
                <Then ?01M02NT0VZCA7Q38V7ZP4HHEHY>
                可以找到 `track`、`implement`、`gap-loop`、`verify` 等生命周期对应的 sub-skill
                根 skill 负责路由或入口说明，sub-skill 负责具体步骤说明
                </?01M02NT0VZCA7Q38V7ZP4HHEHY>
              )>
              <Case { id = "command-wrapper-引用-sub-skill" name = "command wrapper 引用 sub-skill" } (
                <Given ?01M02NT0VZCA7Q38V7ZP4HHEHZ>
                系统为 Claude、Eidolon 或 OpenCode 生成 command 文件
                </?01M02NT0VZCA7Q38V7ZP4HHEHZ>
                <When ?01M02NT0VZCA7Q38V7ZP4HHEJ0>
                用户查看某个 command 提示词
                </?01M02NT0VZCA7Q38V7ZP4HHEJ0>
                <Then ?01M02NT0VZCA7Q38V7ZP4HHEJ1>
                该 command 引用对应的 `codument-workflow` sub-skill
                参数注入、target-specific command 语法与入口提示保留在 command 层
                </?01M02NT0VZCA7Q38V7ZP4HHEJ1>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/gap-loop-子代理创建规则来自公共能力模型" } (
      <Requirement { id = "gap-loop-子代理创建规则来自公共能力模型" } (
        <Statement ?01M02NT0VZCA7Q38V7ZP4HHEJ2>
        系统应当（SHALL）在公共 skill 模板中统一表达 gap-loop 所需的 fresh-subagent 能力模型，并允许各 target 仅补充其等价能力映射。
        </?01M02NT0VZCA7Q38V7ZP4HHEJ2>
        <Suites [
          <Suite { name = "gap-loop-子代理创建规则来自公共能力模型" } (
            <Cases [
              <Case { id = "公共模板描述泛化的-fresh-subagent-能力" name = "公共模板描述泛化的 fresh-subagent 能力" } (
                <Given ?01M02NT0VZCA7Q38V7ZP4HHEJ3>
                系统生成公共 gap-loop sub-skill
                </?01M02NT0VZCA7Q38V7ZP4HHEJ3>
                <When ?01M02NT0VZCA7Q38V7ZP4HHEJ4>
                用户阅读其中关于 fresh round 的规则
                </?01M02NT0VZCA7Q38V7ZP4HHEJ4>
                <Then ?01M02NT0VZCA7Q38V7ZP4HHEJ5>
                文案以通用能力模型说明 `spawn_agent`、`task`、fresh session、delegate worker 或其他等价机制
                不把某个单一 target 的调用方式写死为唯一实现
                </?01M02NT0VZCA7Q38V7ZP4HHEJ5>
              )>
              <Case { id = "target-仅覆盖其最小差异" name = "target 仅覆盖其最小差异" } (
                <Given ?01M02NT0VZCA7Q38V7ZP4HHEJ6>
                不同 target 对 fresh child 的调用方式不同
                </?01M02NT0VZCA7Q38V7ZP4HHEJ6>
                <When ?01M02NT0VZCA7Q38V7ZP4HHEJ7>
                系统生成 target-specific skill 或 command 入口
                </?01M02NT0VZCA7Q38V7ZP4HHEJ7>
                <Then ?01M02NT0VZCA7Q38V7ZP4HHEJ8>
                target 仅补充自己的能力映射示例、manifest 或入口语法
                gap-loop 的核心父层/子代理规则仍来自同一份公共模板
                </?01M02NT0VZCA7Q38V7ZP4HHEJ8>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
