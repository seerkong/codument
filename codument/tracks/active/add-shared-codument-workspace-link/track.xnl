    <MaterialBundle #tests { role = "output" name = "tests" domain = "test" path = "vfs://@/test/cli/" }>
  ]>
  <TaskSpace #space_add-shared-codument-workspace-link { name = "add-shared-codument-workspace-link" version = "1" child_mode = "dag" } (
    <SubNodes [
