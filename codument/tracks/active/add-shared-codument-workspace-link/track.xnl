<Track #add-shared-codument-workspace-link apiVersion="codument.tech/v1alpha1" version="1" { status = "completed" goal = "让 Codument 透明支持 workspace 中用户预先创建的 codument 目录软链接。" description = "普通 init 仍创建普通目录；已有链接时，初始化、升级和所有修改写入链接目标并保留链接。" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-26T12:37:09.424Z" updated_at = "2026-08-26T15:52:48.567Z" modeling_base_commit = "0063620f4dcd2f4b20788862720eaf7a028d4247" engineering_base_commit = "0063620f4dcd2f4b20788862720eaf7a028d4247" } (
  <Ports { scope = "track" } [
